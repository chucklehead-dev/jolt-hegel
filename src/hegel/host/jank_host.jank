(ns hegel.host.jank-host
  "Small C++ host helpers for jank."
  (:include "chrono"
            "cstdlib"
            "filesystem"
            "string"))

(cpp/raw
 "inline std::string hegel_jank_getenv(std::string const &name)
  {
    auto const *value = std::getenv(name.c_str());
    return value == nullptr ? std::string{} : std::string{value};
  }

  inline std::string hegel_jank_current_directory()
  { return std::filesystem::current_path().string(); }

  inline std::string hegel_jank_os_name()
  {
  #if defined(_WIN32)
    return \"Windows\";
  #elif defined(__APPLE__)
    return \"Mac OS X\";
  #elif defined(__linux__)
    return \"Linux\";
  #else
    return \"Unknown\";
  #endif
  }

  inline std::int64_t hegel_jank_nano_time()
  {
    return std::chrono::duration_cast<std::chrono::nanoseconds>(
      std::chrono::steady_clock::now().time_since_epoch()).count();
  }

  inline std::int64_t hegel_jank_current_time_millis()
  {
    return std::chrono::duration_cast<std::chrono::milliseconds>(
      std::chrono::system_clock::now().time_since_epoch()).count();
  }")

(defn getenv [name]
  (let [value (cpp/hegel_jank_getenv name)]
    (when-not (empty? value) value)))

(defn current-directory []
  (cpp/hegel_jank_current_directory))

(defn os-name []
  (cpp/hegel_jank_os_name))

(defn nano-time []
  (cpp/hegel_jank_nano_time))

(defn current-time-millis []
  (cpp/hegel_jank_current_time_millis))

(defn invoke-collection_free [& values]
  (let [native-bindings (cpp/hegel_jank_current_bindings)]
    (cpp/hegel_jank_call_collection_free native-bindings
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_context) (cpp/unbox (:* cpp/void) (nth values 0)))
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_collection) (cpp/unbox (:* cpp/void) (nth values 1))))))

(defn invoke-collection_more [& values]
  (let [native-bindings (cpp/hegel_jank_current_bindings)]
    (cpp/hegel_jank_call_collection_more native-bindings
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_context) (cpp/unbox (:* cpp/void) (nth values 0)))
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_test_case) (cpp/unbox (:* cpp/void) (nth values 1)))
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_collection) (cpp/unbox (:* cpp/void) (nth values 2)))
     (cpp/unsafe-cast (:* cpp/std.uint8_t) (cpp/unbox (:* cpp/void) (nth values 3))))))

(defn invoke-collection_reject [& values]
  (let [native-bindings (cpp/hegel_jank_current_bindings)]
    (cpp/hegel_jank_call_collection_reject native-bindings
     (cpp/unsafe-cast (:* cpp/hegel_jank_hegel_context) (cpp/unbox (:* cpp/void) (nth values 0)))

(def type-layouts
{:c/bool {:alignment 1, :size 1, :type :c/bool},
 :c/double {:alignment 8, :size 8, :type :c/double},
 :c/float {:alignment 4, :size 4, :type :c/float},
 :c/int16 {:alignment 2, :size 2, :type :c/int16},
 :c/int32 {:alignment 4, :size 4, :type :c/int32},
 :c/int64 {:alignment 8, :size 8, :type :c/int64},
 :c/int8 {:alignment 1, :size 1, :type :c/int8},
 :c/size {:alignment 8, :size 8, :type :c/size},
 :c/string {:alignment 8, :size 8, :type :c/string},
 :c/uint16 {:alignment 2, :size 2, :type :c/uint16},
 :c/uint32 {:alignment 4, :size 4, :type :c/uint32},
 :c/uint64 {:alignment 8, :size 8, :type :c/uint64},
 :c/uint8 {:alignment 1, :size 1, :type :c/uint8},
 :c/void {:alignment 1, :size 0, :type :c/void},
 :hegel/bytes-result
 {:alignment 8,
  :fields {[:data] {:offset 0, :type [:pointer :c/uint8]}, [:len] {:offset 8, :type :c/size}},
  :size 16,
  :type :hegel/bytes-result},
 :hegel/date
 {:alignment 4,
  :fields
  {[:day] {:offset 5, :type :c/uint8},
   [:month] {:offset 4, :type :c/uint8},
   [:year] {:offset 0, :type :c/int32}},
  :size 8,
  :type :hegel/date},
 :hegel/datetime
 {:alignment 4,
  :fields
  {[:date :day] {:offset 5, :type :c/uint8},
   [:date :month] {:offset 4, :type :c/uint8},
   [:date :year] {:offset 0, :type :c/int32},
   [:date] {:offset 0, :type :hegel/date},
   [:time :hour] {:offset 8, :type :c/uint8},
   [:time :microsecond] {:offset 12, :type :c/uint32},
   [:time :minute] {:offset 9, :type :c/uint8},
   [:time :second] {:offset 10, :type :c/uint8},
   [:time] {:offset 8, :type :hegel/time}},
  :size 16,
  :type :hegel/datetime},
 :hegel/output-callback {:alignment 8, :size 8, :type :hegel/output-callback},
 :hegel/string-result
 {:alignment 8,
  :fields {[:data] {:offset 0, :type [:pointer :c/int8]}, [:len] {:offset 8, :type :c/size}},
  :size 16,
  :type :hegel/string-result},
 :hegel/time
 {:alignment 4,
  :fields
  {[:hour] {:offset 0, :type :c/uint8},
   [:microsecond] {:offset 4, :type :c/uint32},
   [:minute] {:offset 1, :type :c/uint8},
   [:second] {:offset 2, :type :c/uint8}},
  :size 8,
  :type :hegel/time}}
)


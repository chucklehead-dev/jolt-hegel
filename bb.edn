{:paths ["src" "resources"]

 :tasks
 {setup-native {:task ((requiring-resolve 'hegel.install/-main) "setup")}
  jank-codegen {:extra-paths ["script"]
                :task (apply (requiring-resolve 'hegel.generate-jank-bindings/-main)
                             *command-line-args*)}
  jank-codegen-check {:extra-paths ["script"]
                      :task ((requiring-resolve 'hegel.generate-jank-bindings/-main)
                             "--check")}
  abi-test {:extra-paths ["script"]
            :task (exec 'hegel.abi-check/-main)}
  test {:extra-paths ["test"]
        ;; Development-only: Malli remains optional for consumers.
        :extra-deps {metosin/malli {:mvn/version "0.20.1"}}
        :task (exec 'hegel.test-runner/-main)}}}

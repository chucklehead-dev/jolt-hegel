(ns hegel.jank-property-smoke
  (:require [clojure.string :as str]
            [clojure.test :as ct]
            [hegel.clojure-test :as ht]
            [hegel.core :as h]
            [hegel.generator :as g]
            [hegel.native :as native]
            [hegel.report :as report]
            [hegel.stateful :as hs]))

;; Bounded evidence for the deliberately failing control below: only the
;; final shrunk value is kept, never the full Hegel result or exception.
(def ^:private jank-clojure-test-fail-final-values (atom []))

;; Independent witness that the passing property's body actually executed,
;; so a vacuous synthetic pass (one clojure.test/with never runs its body,
;; or short-circuits before drawing) cannot qualify this integration. The
;; count asserted below is exact, not merely positive.
(def ^:private jank-clojure-test-pass-witness (atom 0))

(def ^:private ipv4-octet-pattern
  #"(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])")

(defn- valid-ipv4-text? [value]
  (let [parts (str/split value #"\.")]
    (and (= 4 (count parts))
         (every? #(some? (re-matches ipv4-octet-pattern %)) parts))))

(defn- valid-ipv6-text? [value]
  (let [compressed-at (str/index-of value "::")
        groups (vec (remove str/blank? (str/split value #":")))]
    (and (<= 2 (count value) 39)
         (some? (re-matches #"[0-9a-f:]+" value))
         (not (str/includes? value ":::"))
         (or (nil? compressed-at)
             (= compressed-at (str/last-index-of value "::")))
         (or (not (str/starts-with? value ":"))
             (str/starts-with? value "::"))
         (or (not (str/ends-with? value ":"))
             (str/ends-with? value "::"))
         (if (some? compressed-at)
           (< (count groups) 8)
           (= 8 (count groups)))
         (every? #(some? (re-matches #"[0-9a-f]{1,4}" %)) groups))))

(ct/deftest jank-clojure-test-embedded-pass
  (ht/with {:test-cases 8
            :seed 20260905
            :database ""
            :verbosity :quiet}
    [x (g/integer 0 10)]
    (swap! jank-clojure-test-pass-witness inc)
    (ct/is (<= 0 x 10))))

;; Deliberately failing control: value >= 500 always fails, so shrinking must
;; converge on the same minimal counterexample (500) already established by
;; the direct h/run-test! threshold smoke below, using the same seed/bounds.
(ct/deftest jank-clojure-test-embedded-fail
  (ht/with {:test-cases 200
            :seed 1777986545686
            :database ""
            :report-multiple-failures? false
            :verbosity :quiet}
    [x (g/integer 0 1000)]
    (when (h/final?)
      (swap! jank-clojure-test-fail-final-values conj x))
    (ct/is (< x 500))))

;; Deliberately throwing control, bounded to a single fixed case: the body
;; raises a plain blank-message exception (never wrapped with :hegel/origin
;; or routed through hffi), so it exercises hegel.clojure-test's
;; throwable-details fallback -- on jank that is the ex-data/type/message/
;; string fallback added because jank has no Throwable->map or class. Below,
;; only a bounded :type keyword and a derived boolean are kept per event,
;; never the message string, the exception, or the Hegel result.
(ct/deftest jank-clojure-test-embedded-body-exception
  (ht/with {:test-cases 1
            :seed 20260906
            :database ""
            :verbosity :quiet
            :suppress-health-checks [:large-initial-test-case]}
    []
    (throw (ex-info "" {:jank/control :body-exception}))))

(defn -main [& _]
  (when-not (and (native/absolute-path? "/tmp/jolt-hegel")
                 (native/absolute-path? "C:\\src\\jolt-hegel")
                 (native/absolute-path? "\\\\server\\share\\jolt-hegel")
                 (native/absolute-path? "\\rooted")
                 (not (native/absolute-path? "src/jolt-hegel"))
                 (= "C:\\src\\jolt-hegel"
                    (native/parent-path
                     "C:\\src\\jolt-hegel\\libhegel_c.dll"))
                 (= "\\\\server\\share\\jolt-hegel"
                    (native/parent-path
                     "\\\\server\\share\\jolt-hegel\\libhegel_c.dll"))
                 (= "C:/"
                    (native/parent-path "C:/src"))
                 (= "C:\\"
                    (native/parent-path "C:\\src"))
                 (= "\\\\server\\share"
                    (native/parent-path "\\\\server\\share"))
                 (= "\\\\server\\share"
                    (native/parent-path "\\\\server\\share\\item"))
                 (= "C:\\src\\jolt-hegel\\libhegel_c.dll"
                    (native/join-path "C:\\src\\jolt-hegel"
                                      "libhegel_c.dll"))
                 (= "libhegel_c.so"
                    (native/join-path "" "libhegel_c.so"))
                 (= "/tmp/jolt-hegel"
                    (native/join-path "/tmp/jolt-hegel" "")))
    (throw (ex-info "jank portable path contract failed" {})))
  (println "PASS shared portable path contract")
  (let [seen (atom [])
        result (h/run-test!
                {:test-cases 10
                 :database ""
                 :seed 424242
                 :verbosity :quiet}
                (fn [_]
                  (let [value (h/draw! (g/integer 0 10))]
                    (swap! seen conj value)
                    (when-not (<= 0 value 10)
                      (throw (ex-info "bounded integer escaped its range"
                                      {:value value}))))))]
    (when-not (and (:passed? result)
                   (= 10 (:valid-test-cases result))
                   (= 10 (count @seen)))
      (throw (ex-info "jank property smoke failed"
                      {:result result :seen @seen})))
    (println "PASS shared property run generated 10 bounded integers")
    (println "PASS seed" (:seed result)))
  ;; Narrow host-promotion slice: boolean, octet, bounded double, fixed-size
  ;; copied byte vectors, strings, regex, documented format generators, and bounded
  ;; vector shapes. Every category list is asserted to hold exactly
  ;; :test-cases entries so a vacuous or short-circuited draw cannot qualify
  ;; this slice. Deliberately excludes g/big-integer and g/float32.
  (let [observed (atom {:true [] :false [] :octets [] :doubles []
                         :strings [] :regexes [] :emails [] :urls []
                         :domains [] :uuids [] :ipv4s [] :ipv6s []
                         :vectors []})
        copies-distinct? (atom true)
        result
        (h/run-test!
         {:test-cases 12
          :seed 20260907
         :database ""
         :verbosity :quiet}
         (fn [_]
           (let [true-value (h/draw! (g/boolean 1.0))
                 false-value (h/draw! (g/boolean 0.0))
                 octet-value (h/draw! (g/octet))
                 double-value (h/draw! (g/double 1.0 2.0))
                 fixed-bytes (h/draw! (g/bytes 6 6))
                 other-bytes (h/draw! (g/bytes 6 6))
                 string-value (h/draw! (g/string {:min-size 1 :max-size 8
                                                   :codec :ascii}))
                 regex-value (h/draw! (g/regex-str "jank-[0-9]{1,3}"))
                 email-value (h/draw! (g/email))
                 url-value (h/draw! (g/url-str))
                 domain-value (h/draw! (g/domain {:max-length 40}))
                 uuid-value (h/draw! (g/uuid))
                 ipv4-value (h/draw! (g/ipv4))
                 ipv6-value (h/draw! (g/ipv6))
                 vector-value (h/draw! (g/vector {:min-size 2 :max-size 4}
                                                  (g/integer 0 9)))]
             (when (identical? fixed-bytes other-bytes)
               (reset! copies-distinct? false))
             (when-not (and (vector? fixed-bytes)
                            (vector? other-bytes)
                            (= 6 (count fixed-bytes))
                            (= 6 (count other-bytes))
                            (every? #(and (integer? %) (<= 0 % 255))
                                    fixed-bytes)
                            (every? #(and (integer? %) (<= 0 % 255))
                                    other-bytes))
               (throw (ex-info "fixed-size byte draw escaped its bounds"
                                {:fixed (vec fixed-bytes)})))
             (swap! observed
                    (fn [seen]
                      (-> seen
                          (update :true conj true-value)
                          (update :false conj false-value)
                          (update :octets conj octet-value)
                          (update :doubles conj double-value)
                          (update :strings conj string-value)
                          (update :regexes conj regex-value)
                          (update :emails conj email-value)
                          (update :urls conj url-value)
                          (update :domains conj domain-value)
                          (update :uuids conj uuid-value)
                          (update :ipv4s conj ipv4-value)
                          (update :ipv6s conj ipv6-value)
                          (update :vectors conj vector-value)))))))
        seen @observed
        checks
        [["run passed" (:passed? result)]
         ["valid case count" (= 12 (:valid-test-cases result))]
         ["byte results are distinct" (true? @copies-distinct?)]
         ["draw counts" (every? #(= 12 (count %)) (vals seen))]
         ["true endpoint" (every? true? (:true seen))]
         ["false endpoint" (every? false? (:false seen))]
         ["octet bounds"
          (every? #(and (integer? %) (<= 0 % 255)) (:octets seen))]
         ["double bounds" (every? #(<= 1.0 % 2.0) (:doubles seen))]
         ["string bounds" (every? #(<= 1 (count %) 8) (:strings seen))]
         ["regex shape"
          (every? #(some? (re-matches #"jank-[0-9]{1,3}" %))
                  (:regexes seen))]
         ["email shape" (every? #(str/includes? % "@") (:emails seen))]
         ["URL shape"
          (every? #(or (str/starts-with? % "http://")
                       (str/starts-with? % "https://"))
                  (:urls seen))]
         ["domain bounds" (every? #(<= 1 (count %) 40) (:domains seen))]
         ["UUID shape"
          (every? #(some? (re-matches
                            #"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                            %))
                  (:uuids seen))]
         ["IPv4 shape" (every? valid-ipv4-text? (:ipv4s seen))]
         ["IPv6 shape" (every? valid-ipv6-text? (:ipv6s seen))]
         ["vector bounds"
          (every? #(and (vector? %) (<= 2 (count %) 4)) (:vectors seen))]]
        failed-checks (vec (clojure.core/map first (remove second checks)))]
    (when (seq failed-checks)
      (println "FAIL jank narrow generator checks" failed-checks)
      (throw (ex-info "jank narrow generator smoke failed"
                      {:result result :observed seen
                       :failed-checks failed-checks})))
    (println "PASS shared boolean, octet, bounded double, and fixed-size copied byte-vector generators")
    (println "PASS shared string, regex, and documented format generators")
    (println "PASS shared bounded vector shapes"))
  (let [final-values (atom [])
        result
        (h/run-test!
         {:test-cases 200
          :seed 1777986545686
          :database ""
          :report-multiple-failures? false
          :verbosity :quiet}
         (fn [_]
           (let [value (h/draw! (g/integer 0 1000))]
             (when (h/final?)
               (swap! final-values conj value))
             (when (>= value 500)
               (throw
                (ex-info "threshold violated"
                         {:hegel/origin "hegel.jank-property-smoke:threshold"
                          :value value}))))))
        failure (first (:failures result))
        final-outcome (first (:final result))]
    (when-not (and (not (:passed? result))
                   (= :failed (:status result))
                   (= 1 (:n-failures result))
                   (= "hegel.jank-property-smoke:threshold" (:origin failure))
                   (= "AAEAAAAACgIAAAD0AQ==" (:reproduction-blob failure))
                   (= [500] @final-values)
                   (= 500 (-> final-outcome :exception ex-data :value))
                   (:reproduced? failure)
                   (false? (:flaky? result)))
      (throw (ex-info "jank shrinking/replay smoke failed"
                      {:result result :final-values @final-values})))
    (println "PASS shared shrinking found and replayed threshold 500"))
  (let [fixed-date {:year 2024 :month 2 :day 29}
        fixed-time {:hour 14 :minute 30 :second 15 :microsecond 123456}
        fixed-datetime {:date fixed-date :time fixed-time}
        observed (atom [])
        result
        (h/run-test!
         {:test-cases 5
          :seed 20240829
          :database ""
          :verbosity :quiet}
         (fn [_]
           (swap! observed conj
                  [(h/draw! (g/date fixed-date fixed-date))
                   (h/draw! (g/time fixed-time fixed-time))
                   (h/draw! (g/datetime fixed-datetime fixed-datetime))])))]
    (when-not (and (:passed? result)
                   (seq @observed)
                   (every? #(= ["2024-02-29"
                                "14:30:15.123456"
                                "2024-02-29T14:30:15.123456"]
                               %)
                           @observed))
      (throw (ex-info "jank temporal generator smoke failed"
                      {:result result :observed @observed})))
    (println "PASS shared date/time/datetime generators use by-value structs"))
  (let [observed (atom [])
        result
        (h/run-test!
         {:test-cases 10
          :seed 20260825
          :database ""
          :verbosity :quiet}
         (fn [_]
           (let [pool (hs/pool)]
             (hs/add! pool 10)
             (hs/add! pool 20)
             (let [reusable (h/draw! (hs/values-reusable pool))
                   first-value (h/draw! (hs/values-consumed pool))
                   second-value (h/draw! (hs/values-consumed pool))]
               (swap! observed conj
                      {:reusable reusable
                       :consumed #{first-value second-value}
                       :empty? (hs/pool-empty? pool)})))))]
    (when-not (and (:passed? result)
                   (= 10 (count @observed))
                   (every? (fn [{:keys [reusable consumed empty?]}]
                             (and (contains? #{10 20} reusable)
                                  (= #{10 20} consumed)
                                  empty?))
                           @observed))
      (throw (ex-info "jank stateful pool smoke failed"
                      {:result result :observed @observed})))
    (println "PASS shared reusable and consumed pools preserve ownership"))
  (let [steps (atom 0)
        result
        (h/run-test!
         {:test-cases 10
          :stateful-step-count 12
          :seed 99117
          :database ""
          :verbosity :quiet}
         (fn [_]
           (let [final-state
                 (hs/run!
                  {:initial-state 0
                   :rules
                   [(hs/rule :increment
                             (fn [state]
                               (swap! steps inc)
                               (inc state)))
                    (hs/rule :decrement
                             {:precondition pos?}
                             (fn [state]
                               (swap! steps inc)
                               (dec state)))]
                   :invariants
                   [(hs/invariant :nonnegative
                                  (fn [state] (<= 0 state)))]})]
             (when (neg? final-state)
               (throw (ex-info "state machine escaped invariant"
                               {:state final-state}))))))]
    (when-not (and (:passed? result) (pos? @steps))
      (throw (ex-info "jank stateful/swarm smoke failed"
                      {:result result :steps @steps})))
    (println "PASS shared stateful/swarm run preserved its model invariant"))
  (let [calls (atom 0)
        assumption-result
        (h/run-test!
         {:test-cases 1 :seed 27 :database "" :verbosity :quiet}
         (fn [_]
           (h/assume! (> (swap! calls inc) 1))))]
    (when-not (and (:passed? assumption-result)
                   (= 1 (:invalid-test-cases assumption-result))
                   (= 0 (:valid-test-cases assumption-result))
                   (= 1 @calls))
      (throw (ex-info "jank assumption smoke failed"
                      {:result assumption-result :calls @calls})))
    (println "PASS shared assumption rejects one deterministic invalid case"))
  (let [events (atom [])
        runner (report/counting-runner {:reporter #(swap! events conj %)})
        pass-result
        (report/run!
         runner "pass"
         #(h/run-test! {:test-cases 1 :seed 31 :database "" :verbosity :quiet}
                       (fn [_] nil)))
        fail-result
        (report/run!
         runner "fail"
         #(h/run-test!
           {:test-cases 1 :seed 37 :database "" :verbosity :quiet}
           (fn [_]
             (throw (ex-info "expected"
                             {:hegel/origin "hegel.jank-property-smoke:report"})))))
        error-result
        (report/run! runner "error"
                     #(throw (ex-info "expected setup error" {:phase :setup})))
        failure (first (:failures fail-result))
        event-types (mapv :type @events)
        counts {:runs (report/run-count runner)
                :failures (report/failure-count runner)}
        failure-origin (:origin failure)]
    (when-not (and (:passed? pass-result)
                   (not (:passed? fail-result))
                   (nil? error-result)
                   (= {:runs 3 :failures 2} counts)
                   (= [:pass :fail :error] event-types)
                   (= "hegel.jank-property-smoke:report" failure-origin))
      (throw (ex-info "jank counting/reporting smoke failed"
                      {:event-types event-types
                       :counts counts
                       :failure-origin failure-origin})))
    (println "PASS shared counting runner sees pass, property failure, and setup error")
    (println "PASS run-count 3 failure-count 2 with event types [:pass :fail :error]"))
  ;; Qualify hegel.clojure-test itself using only the clojure.test surface
  ;; upstream jank's own self-test exercises: deftest/is/run-test, plus the
  ;; dynamic `report` rebinding hegel.clojure-test/with itself relies on
  ;; internally. `run-test` is the public call surface exercised here -- it
  ;; always calls test-var internally, so this is not a claim that test-var
  ;; itself goes unexercised, only that this smoke never calls it directly.
  ;; Never anything JVM-only.
  (reset! jank-clojure-test-fail-final-values [])
  (reset! jank-clojure-test-pass-witness 0)
  (let [pass-summary (select-keys (ct/run-test jank-clojure-test-embedded-pass)
                                   [:test :pass :fail :error])
        fail-summary (select-keys (ct/run-test jank-clojure-test-embedded-fail)
                                   [:test :pass :fail :error])]
    (when-not (= {:test 1 :pass 1 :fail 0 :error 0} pass-summary)
      (throw (ex-info "jank clojure.test embedded pass summary mismatch"
                      {:summary pass-summary})))
    (when-not (= 8 @jank-clojure-test-pass-witness)
      (throw (ex-info "jank clojure.test embedded pass control did not execute its body the expected number of times"
                      {:witness @jank-clojure-test-pass-witness})))
    (when-not (= {:test 1 :pass 0 :fail 1 :error 0} fail-summary)
      (throw (ex-info "jank clojure.test embedded fail summary mismatch"
                      {:summary fail-summary})))
    (when-not (= [500] @jank-clojure-test-fail-final-values)
      (throw (ex-info "jank clojure.test expected-fail control did not shrink to its known minimum"
                      {:final-values @jank-clojure-test-fail-final-values})))
    (println "PASS jank clojure.test deftest/is/run-test host hegel.clojure-test/with")
    (println "PASS embedded pass control executed its body exactly 8 times")
    (println "PASS run-test summary accounting: exactly one expected failure, no errors"))
  ;; The body-exception control's expected failure must never fail this
  ;; script; only mismatched summary/event semantics do.
  (let [events (atom [])
        original-report ct/report
        body-exception-summary
        (binding [ct/report
                  (fn [event]
                    (swap! events conj
                           {:type (:type event)
                            :has-ex-data?
                            (boolean
                             (some #(and (string? %)
                                         (str/includes? % "ex-data:"))
                                   [(:message event) (:actual event)]))})
                    (original-report event))]
          (select-keys (ct/run-test jank-clojure-test-embedded-body-exception)
                       [:test :pass :fail :error]))
        reported (into []
                       (filter #(#{:pass :fail :error} (:type %)))
                       @events)]
    (when-not (= {:test 1 :pass 0 :fail 1 :error 0} body-exception-summary)
      (throw (ex-info "jank clojure.test body-exception summary mismatch"
                      {:summary body-exception-summary})))
    (when-not (= [:fail] (mapv :type reported))
      (throw (ex-info "jank clojure.test body-exception event types mismatch"
                      {:events reported})))
    (when-not (true? (:has-ex-data? (first reported)))
      (throw (ex-info "jank clojure.test body-exception fallback lost its ex-data detail"
                      {:events reported})))
    (println "PASS jank clojure.test body-exception control exercises the jank throwable-details fallback")
    (println "PASS body-exception summary accounting: exactly one expected failure, no errors")))
